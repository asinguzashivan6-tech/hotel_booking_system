# MongoDB connection string (required)
# Local MongoDB example:
MONGO_URI=mongodb://127.0.0.1:27017/marriott_hms
# MongoDB Atlas example (recommended for Vercel deployment):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/marriott_hms

# Server port (optional, default: 5000)
PORT=5000

# Environment (optional): development | production | test
NODE_ENV=development

# JWT auth (required for login-protected API actions)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Billing
TAX_RATE=0.10
